/* ==========================================================================
   HOMEPAGE CONTINUOUS CINEMATIC VIDEO & SCROLL-DRIVEN EXPERIENCE
   ========================================================================== */

.om-home-page {
  position: relative;
  background-color: transparent;
  min-height: 100vh;
  overflow-x: hidden;
}

/* ==========================================================================
   1. PERSISTENT FIXED VIDEO BACKDROP (SINGLE INSTANCE ACROSS ENTIRE PAGE)
   ========================================================================== */
.om-persistent-video-backdrop {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  background: #0D1612;
}

.om-persistent-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transform: scale(1.02);
  will-change: transform;
}

/* Ambient Scrims: Ensures High Contrast & 100% Readability Across All Sections */
.om-video-scrim-ambient {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 25%, rgba(13, 22, 18, 0.25) 0%, rgba(13, 22, 18, 0.65) 100%),
              linear-gradient(180deg, rgba(250, 249, 245, 0.76) 0%, rgba(243, 239, 230, 0.82) 40%, rgba(13, 22, 18, 0.75) 100%);
  pointer-events: none;
}

.om-video-vignette-global {
  position: absolute;
  inset: 0;
  box-shadow: inset 0 0 120px rgba(0, 0, 0, 0.5);
  pointer-events: none;
}

/* ==========================================================================
   2. FLOATING CINEMATIC CONTROLLER HUD
   ========================================================================== */
.om-cinematic-hud {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 90;
  pointer-events: auto;
}

.om-hud-pill {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 14px;
  border-radius: var(--radius-full);
  background: rgba(13, 22, 18, 0.88);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.16);
  box-shadow: 0 12px 36px rgba(0, 0, 0, 0.35);
  color: #FFFFFF;
}

.om-hud-live-tag {
  display: flex;
  align-items: center;
  gap: 8px;
}

.om-hud-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #10B981;
  box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.3);
  transition: all 0.2s ease;
}

.om-hud-dot.pulse {
  background: #C89B5C;
  box-shadow: 0 0 0 4px rgba(200, 155, 92, 0.4);
  animation: pulseDot 0.8s infinite alternate;
}

@keyframes pulseDot {
  from { transform: scale(0.9); }
  to { transform: scale(1.25); }
}

.om-hud-status {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: #FFFFFF;
  white-space: nowrap;
}

.om-hud-progress-bar {
  width: 48px;
  height: 3px;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.18);
  overflow: hidden;
}

.om-hud-progress-fill {
  height: 100%;
  background: var(--accent-gold);
  border-radius: var(--radius-full);
  transition: width 0.25s linear;
}

.om-hud-buttons {
  display: flex;
  align-items: center;
  gap: 6px;
  border-left: 1px solid rgba(255, 255, 255, 0.14);
  padding-left: 8px;
}

.om-hud-icon-btn {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: rgba(255, 255, 255, 0.1);
  color: #FFFFFF;
  transition: all 0.2s ease;
}

.om-hud-icon-btn:hover {
  background: var(--accent-gold);
  color: #FFFFFF;
  transform: scale(1.08);
}

@media (max-width: 600px) {
  .om-cinematic-hud {
    bottom: 16px;
    right: 16px;
  }
  .om-hud-progress-bar {
    display: none;
  }
}

/* ==========================================================================
   3. CONTENT SECTIONS FLOW (LAYERED ABOVE CONTINUOUS VIDEO)
   ========================================================================== */
.om-home-sections-flow {
  position: relative;
  z-index: 1;
}

/* ==========================================================================
   HERO STAGE
   ========================================================================== */
.om-hero-stage {
  min-height: calc(100vh - 82px);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(60px, 8vw, 100px) 0 clamp(40px, 6vw, 80px);
}

.om-hero-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: clamp(36px, 5vw, 56px);
}

.om-hero-glass-hero {
  max-width: 960px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: clamp(32px, 5vw, 54px) clamp(24px, 4vw, 48px);
  background: rgba(250, 249, 245, 0.88);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: var(--radius-xl);
  border: 1px solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 24px 64px -12px rgba(13, 22, 18, 0.15);
}

.om-hero-title {
  font-size: clamp(2.6rem, 5.8vw, 4.8rem);
  font-weight: 500;
  letter-spacing: -0.025em;
  line-height: 1.06;
  margin-bottom: 1.25rem;
  color: var(--text-primary);
}

.om-hero-lead {
  font-size: clamp(1.05rem, 1.4vw, 1.25rem);
  color: var(--text-secondary);
  line-height: 1.7;
  max-width: 760px;
  margin-bottom: 2rem;
}

.om-hero-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
  margin-bottom: 24px;
}

/* Scroll Invitation */
.om-hero-scroll-invite {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  margin-top: 10px;
  padding-top: 20px;
  border-top: 1px solid var(--border-light);
  width: 100%;
}

.om-scroll-invite-text {
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent-gold-hover);
}

.om-scroll-indicator-mouse {
  width: 20px;
  height: 32px;
  border-radius: 12px;
  border: 2px solid var(--accent-gold);
  position: relative;
  display: grid;
  place-items: center;
}

.om-mouse-wheel-dot {
  width: 4px;
  height: 6px;
  border-radius: 2px;
  background: var(--accent-gold);
  animation: mouseWheelMove 1.8s infinite;
}

@keyframes mouseWheelMove {
  0% { transform: translateY(-5px); opacity: 1; }
  100% { transform: translateY(7px); opacity: 0; }
}

/* Hero Stats Ribbon */
.om-hero-stats-ribbon {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18px;
  width: 100%;
  max-width: 1140px;
}

@media (min-width: 600px) {
  .om-hero-stats-ribbon {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .om-hero-stats-ribbon {
    grid-template-columns: repeat(4, 1fr);
  }
}

.om-stat-pill-card {
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: 0 10px 30px rgba(13, 22, 18, 0.08);
  text-align: left;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.om-stat-pill-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 40px rgba(13, 22, 18, 0.12);
  border-color: var(--accent-gold);
}

.om-stat-num {
  font-family: var(--font-serif);
  font-size: 2.2rem;
  font-weight: 600;
  line-height: 1;
  color: var(--accent-gold-hover);
  margin-bottom: 6px;
}

.om-stat-label {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.om-stat-sub {
  font-size: 0.8rem;
  color: var(--text-muted);
  line-height: 1.5;
  margin: 0;
}

/* ==========================================================================
   4. MARQUEE STRIP
   ========================================================================== */
.om-marquee-strip {
  padding: 24px 0 32px;
  background: rgba(250, 249, 245, 0.85);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-top: 1px solid var(--border-light);
  border-bottom: 1px solid var(--border-light);
  overflow: hidden;
}

.om-marquee-tag {
  text-align: center;
  margin-bottom: 16px;
}

.om-marquee-tag span {
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.24em;
  color: var(--accent-gold-hover);
  text-transform: uppercase;
}

.om-marquee-window {
  width: 100%;
  overflow: hidden;
  display: flex;
}

.om-marquee-content {
  display: flex;
  align-items: center;
  gap: 32px;
  animation: marqueeScroll 45s linear infinite;
  min-width: max-content;
}

.om-marquee-content:hover {
  animation-play-state: paused;
}

.om-marquee-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 22px;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-full);
  transition: all 0.25s ease;
  height: 48px;
}

.om-marquee-badge:hover {
  background: #FFFFFF;
  border-color: var(--accent-gold);
  transform: translateY(-2px);
  box-shadow: var(--shadow-sm);
}

.om-marquee-svg {
  height: 24px;
  width: auto;
  display: flex;
  align-items: center;
}

.om-marquee-svg svg {
  height: 100%;
  width: auto;
  max-width: 120px;
}

.om-marquee-name {
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: var(--text-primary);
}

/* ==========================================================================
   5. GENERIC SECTION PANEL CONTAINER
   All content panels have glassmorphism allowing continuous video visibility!
   ========================================================================== */
.om-section-panel {
  padding: clamp(70px, 9vw, 120px) 0;
  position: relative;
}

.om-panel-header {
  display: flex;
  flex-direction: column;
  gap: 24px;
  margin-bottom: 48px;
}

.om-panel-header.centered {
  text-align: center;
  max-width: 820px;
  margin-left: auto;
  margin-right: auto;
  align-items: center;
}

@media (min-width: 1024px) {
  .om-panel-header:not(.centered) {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
  }
}

.om-section-lead {
  font-size: 1.15rem;
  color: var(--text-secondary);
  line-height: 1.75;
  margin-bottom: 2rem;
}

.om-section-ctas {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}

/* ==========================================================================
   ARCHITECTURAL HORIZON PANEL
   ========================================================================== */
.om-arch-panel {
  background: rgba(250, 249, 245, 0.84);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border-light);
}

.om-arch-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(40px, 6vw, 80px);
  align-items: center;
}

@media (min-width: 980px) {
  .om-arch-layout {
    grid-template-columns: 1fr 1fr;
  }
}

.om-arch-imagery {
  position: relative;
}

.om-arch-card-primary {
  position: relative;
  width: 90%;
  aspect-ratio: 4 / 4.8;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--border-light);
}

.om-arch-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s ease;
}

.om-arch-card-primary:hover .om-arch-photo {
  transform: scale(1.04);
}

.om-arch-photo-overlay {
  position: absolute;
  bottom: 24px;
  left: 24px;
  right: 24px;
  padding: 16px 20px;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(16px);
  border-radius: var(--radius-md);
  border: 1px solid rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  gap: 14px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

.om-arch-spark {
  color: var(--accent-gold);
  font-size: 1.5rem;
  line-height: 1;
}

.om-arch-photo-overlay strong {
  display: block;
  font-size: 0.92rem;
  color: var(--text-primary);
}

.om-arch-photo-overlay span {
  display: block;
  font-size: 0.78rem;
  color: var(--text-muted);
}

.om-arch-card-secondary {
  position: absolute;
  bottom: -30px;
  right: 0;
  width: 50%;
  aspect-ratio: 4 / 3.4;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-xl);
  border: 4px solid #FFFFFF;
}

.om-arch-sec-overlay {
  position: absolute;
  bottom: 12px;
  left: 12px;
  right: 12px;
  background: rgba(13, 22, 18, 0.85);
  backdrop-filter: blur(10px);
  border-radius: var(--radius-sm);
  padding: 8px 12px;
  color: #FFFFFF;
}

.om-arch-sec-overlay span {
  display: block;
  font-size: 0.65rem;
  color: var(--accent-gold);
  text-transform: uppercase;
  font-weight: 700;
  letter-spacing: 0.1em;
}

.om-arch-sec-overlay strong {
  display: block;
  font-size: 0.8rem;
}

.om-arch-narrative {
  display: flex;
  flex-direction: column;
}

.om-arch-perks-stack {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-bottom: 2.5rem;
}

.om-perk-row {
  display: flex;
  align-items: flex-start;
  gap: 16px;
}

.om-perk-icon-sq {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-md);
  background: var(--accent-emerald-light);
  color: var(--accent-emerald);
  display: grid;
  place-items: center;
  flex-shrink: 0;
}

.om-perk-row h4 {
  font-family: var(--font-sans);
  font-size: 1.05rem;
  font-weight: 700;
  margin-bottom: 4px;
  color: var(--text-primary);
}

.om-perk-row p {
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.6;
  margin: 0;
}

/* ==========================================================================
   BRANDS SHOWCASE PANEL
   ========================================================================== */
.om-brands-panel {
  background: rgba(243, 239, 230, 0.86);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--border-light);
}

.om-filter-pill-group {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.om-filter-pill {
  padding: 8px 18px;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid var(--border-medium);
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--text-secondary);
  transition: all 0.2s ease;
}

.om-filter-pill:hover {
  border-color: var(--accent-gold);
  color: var(--text-primary);
}

.om-filter-pill.active {
  background: var(--bg-dark);
  color: #FFFFFF;
  border-color: var(--bg-dark);
  box-shadow: var(--shadow-sm);
}

.om-filter-pill.dark {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.15);
  color: var(--text-dark-secondary);
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.om-filter-pill.dark:hover {
  background: rgba(255, 255, 255, 0.16);
  color: #FFFFFF;
}

.om-filter-pill.dark.active {
  background: var(--accent-gold);
  color: #FFFFFF;
  border-color: var(--accent-gold);
}

.om-brands-cards-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}

@media (min-width: 600px) {
  .om-brands-cards-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .om-brands-cards-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.om-editorial-brand-card {
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(13, 22, 18, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.8);
  display: flex;
  flex-direction: column;
  transition: transform 0.35s ease, box-shadow 0.35s ease;
}

.om-editorial-brand-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 40px rgba(13, 22, 18, 0.14);
}

.om-brand-media-top {
  position: relative;
  height: 200px;
  padding: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.om-brand-svg-box {
  width: 75%;
  height: 60px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.om-brand-svg-box svg {
  max-width: 100%;
  max-height: 100%;
}

.om-brand-ambassador-cutout {
  position: absolute;
  right: -10px;
  bottom: 0;
  height: 140px;
  width: auto;
  object-fit: contain;
  z-index: 2;
  filter: drop-shadow(0 8px 12px rgba(0,0,0,0.4));
  transition: transform 0.4s ease;
}

.om-editorial-brand-card:hover .om-brand-ambassador-cutout {
  transform: scale(1.08) translateY(-4px);
}

.om-brand-level-badge {
  position: absolute;
  top: 14px;
  left: 14px;
  z-index: 3;
  padding: 4px 10px;
  border-radius: var(--radius-full);
  background: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #FFFFFF;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.05em;
}

.om-brand-card-details {
  padding: 22px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.om-brand-card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.om-brand-category-tag {
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--accent-gold-hover);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.om-brand-celeb-tag {
  font-size: 0.7rem;
  color: var(--text-muted);
  font-weight: 600;
}

.om-brand-title-text {
  font-family: var(--font-sans);
  font-size: 1.25rem;
  font-weight: 800;
  margin-bottom: 6px;
  color: var(--text-primary);
}

.om-brand-quote {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 0.95rem;
  color: var(--accent-gold-hover);
  margin-bottom: 10px;
}

.om-brand-narrative {
  font-size: 0.82rem;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 18px;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.om-brand-bottom-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 14px;
  border-top: 1px solid var(--border-light);
}

.om-brand-link-action {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--text-primary);
  transition: color 0.2s ease;
}

.om-brand-link-action:hover {
  color: var(--accent-gold-hover);
}

.om-brand-pin-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: var(--radius-full);
  background: var(--bg-secondary);
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--text-secondary);
  transition: all 0.2s ease;
}

.om-brand-pin-btn:hover {
  background: var(--bg-dark);
  color: #FFFFFF;
}

.om-panel-summary-bar {
  margin-top: 48px;
  padding: 24px 32px;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  gap: 16px;
  align-items: center;
  text-align: center;
}

@media (min-width: 768px) {
  .om-panel-summary-bar {
    flex-direction: row;
    justify-content: space-between;
    text-align: left;
  }
}

.om-panel-summary-bar p {
  margin: 0;
  color: var(--text-secondary);
  font-size: 0.95rem;
}

/* ==========================================================================
   CINEMA PANEL
   Deep twilight glass tint allowing video to glow underneath
   ========================================================================== */
.om-cinema-panel {
  background: rgba(10, 17, 14, 0.88);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  color: var(--text-dark-primary);
  border-bottom: 1px solid var(--border-dark);
}

.om-cinema-cards-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 28px;
  margin-bottom: 50px;
}

@media (min-width: 640px) {
  .om-cinema-cards-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .om-cinema-cards-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.om-cinema-movie-card {
  background: rgba(21, 34, 29, 0.9);
  border: 1px solid var(--border-dark);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-dark);
  transition: transform 0.35s ease, border-color 0.35s ease;
}

.om-cinema-movie-card:hover {
  transform: translateY(-6px);
  border-color: rgba(200, 155, 92, 0.4);
}

.om-movie-poster-box {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background: #000000;
}

.om-movie-poster-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.om-cinema-movie-card:hover .om-movie-poster-image {
  transform: scale(1.05);
}

.om-movie-censor-badge {
  position: absolute;
  top: 14px;
  left: 14px;
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(8px);
  color: #FFFFFF;
  font-size: 0.75rem;
  font-weight: 700;
}

.om-movie-laser-badge {
  position: absolute;
  bottom: 14px;
  left: 14px;
  right: 14px;
  padding: 6px 12px;
  border-radius: var(--radius-sm);
  background: rgba(13, 22, 18, 0.85);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: var(--accent-gold);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.05em;
}

.om-movie-card-info {
  padding: 24px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.om-movie-meta-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.75rem;
  color: var(--text-dark-secondary);
  margin-bottom: 8px;
}

.om-movie-headline {
  font-family: var(--font-sans);
  font-size: 1.35rem;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 4px;
}

.om-movie-language-txt {
  font-size: 0.78rem;
  color: var(--accent-gold);
  margin-bottom: 12px;
  font-weight: 600;
}

.om-movie-synopsis {
  font-size: 0.82rem;
  color: var(--text-dark-secondary);
  line-height: 1.6;
  margin-bottom: 18px;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.om-movie-showtimes-section {
  margin-bottom: 20px;
}

.om-times-heading {
  font-size: 0.72rem;
  font-weight: 800;
  color: var(--accent-gold);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.om-times-pills-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.om-time-pill-item {
  padding: 5px 10px;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #FFFFFF;
  font-size: 0.74rem;
  font-weight: 600;
}

.om-movie-cta-wrap {
  margin-top: auto;
}

.om-movie-action-btn {
  width: 100%;
  padding: 11px;
  font-size: 0.8rem;
}

.om-gamezone-strip-card {
  background: linear-gradient(135deg, rgba(21, 34, 29, 0.95), rgba(30, 48, 40, 0.95));
  border: 1px solid var(--border-dark);
  border-radius: var(--radius-xl);
  display: grid;
  grid-template-columns: 1fr;
  overflow: hidden;
  box-shadow: var(--shadow-dark);
}

@media (min-width: 860px) {
  .om-gamezone-strip-card {
    grid-template-columns: 1.2fr 1fr;
  }
}

.om-gamezone-copy {
  padding: clamp(30px, 5vw, 50px);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
}

.om-gamezone-copy h3 {
  font-size: clamp(1.8rem, 3vw, 2.4rem);
  color: #FFFFFF;
  margin-bottom: 12px;
}

.om-gamezone-copy p {
  color: var(--text-dark-secondary);
  font-size: 0.95rem;
  line-height: 1.65;
  margin-bottom: 24px;
}

.om-gamezone-photo-frame {
  height: 100%;
  min-height: 240px;
}

.om-gamezone-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ==========================================================================
   DINING PANEL
   ========================================================================== */
.om-dining-panel {
  background: rgba(250, 249, 245, 0.85);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border-light);
}

.om-dining-split-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(40px, 6vw, 70px);
  align-items: center;
}

@media (min-width: 980px) {
  .om-dining-split-layout {
    grid-template-columns: 1fr 1fr;
  }
}

.om-dining-outlets-stack {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 24px;
}

.om-dining-outlet-item {
  padding: 12px 18px;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s ease;
}

.om-dining-outlet-item:hover {
  transform: translateX(4px);
  border-color: var(--accent-gold);
}

.om-dining-outlet-item strong {
  font-size: 1.05rem;
  font-weight: 800;
  color: var(--text-primary);
}

.om-dining-outlet-item span {
  font-size: 0.8rem;
  color: var(--accent-gold-hover);
  font-weight: 600;
}

.om-dining-bullets-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 30px;
}

.om-bullet-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.om-bullet-spark {
  color: var(--accent-gold);
  font-size: 1.1rem;
  line-height: 1.4;
}

.om-bullet-item strong {
  display: block;
  font-size: 0.95rem;
  color: var(--text-primary);
}

.om-bullet-item span {
  display: block;
  font-size: 0.85rem;
  color: var(--text-muted);
}

.om-dining-photos-col {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.om-dining-hero-card {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 10;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--border-light);
}

.om-dining-hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.om-dining-hero-card:hover .om-dining-hero-img {
  transform: scale(1.04);
}

.om-dining-time-pill {
  position: absolute;
  bottom: 18px;
  left: 18px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  border-radius: var(--radius-full);
  background: rgba(13, 22, 18, 0.85);
  backdrop-filter: blur(10px);
  color: #FFFFFF;
  font-size: 0.75rem;
  font-weight: 700;
}

.om-dining-twin-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

.om-dining-mini-card {
  aspect-ratio: 4 / 3;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  border: 1px solid var(--border-light);
}

.om-mini-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.om-dining-mini-card:hover .om-mini-img {
  transform: scale(1.06);
}

/* ==========================================================================
   FLOOR SELECTOR PANEL
   ========================================================================== */
.om-floor-panel {
  background: rgba(243, 239, 230, 0.86);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--border-light);
}

.om-floor-interactive-hub {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.om-floor-tab-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: center;
}

.om-floor-select-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12px 20px;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid var(--border-medium);
  transition: all 0.25s ease;
  min-width: 140px;
}

.om-floor-select-btn:hover {
  border-color: var(--accent-gold);
  transform: translateY(-2px);
}

.om-floor-select-btn.active {
  background: var(--bg-dark);
  color: #FFFFFF;
  border-color: var(--bg-dark);
  box-shadow: var(--shadow-md);
}

.om-btn-floor-tag {
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: var(--accent-gold);
  margin-bottom: 2px;
}

.om-btn-floor-name {
  font-size: 0.95rem;
  font-weight: 700;
}

.om-floor-feature-card {
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  display: grid;
  grid-template-columns: 1fr;
}

@media (min-width: 900px) {
  .om-floor-feature-card {
    grid-template-columns: 1.2fr 0.8fr;
  }
}

.om-floor-card-left {
  padding: clamp(32px, 5vw, 56px);
  display: flex;
  flex-direction: column;
}

.om-floor-kicker {
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.18em;
  color: var(--accent-gold-hover);
  text-transform: uppercase;
  margin-bottom: 8px;
}

.om-floor-title-heading {
  font-size: clamp(2rem, 3.5vw, 3rem);
  font-weight: 600;
  margin-bottom: 8px;
  color: var(--text-primary);
}

.om-floor-summary-line {
  font-size: 1.05rem;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 24px;
}

.om-floor-tenants-box strong {
  display: block;
  font-size: 0.85rem;
  color: var(--text-primary);
  margin-bottom: 12px;
}

.om-tenants-pill-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 32px;
}

.om-tenant-pill {
  padding: 6px 14px;
  border-radius: var(--radius-full);
  background: var(--bg-secondary);
  border: 1px solid var(--border-medium);
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--text-primary);
}

.om-floor-card-ctas {
  margin-top: auto;
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}

.om-floor-card-right {
  background: linear-gradient(135deg, #141E19, #0D1612);
  display: grid;
  place-items: center;
  padding: 40px;
  position: relative;
  overflow: hidden;
  min-height: 300px;
}

.om-3d-scene-mockup {
  position: relative;
  width: 220px;
  height: 220px;
  display: grid;
  place-items: center;
}

.om-mockup-ring {
  position: absolute;
  width: 220px;
  height: 220px;
  border-radius: 50%;
  border: 1px dashed rgba(200, 155, 92, 0.4);
  animation: spinSlow 30s linear infinite;
}

.om-mockup-ring.ring-inner {
  width: 170px;
  height: 170px;
  border-color: rgba(255, 255, 255, 0.15);
  animation: spinSlow 20s linear infinite reverse;
}

.om-mockup-plinth {
  width: 120px;
  height: 120px;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, #C89B5C, #8C652D);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 15px 35px rgba(200, 155, 92, 0.35);
  transform: rotate(-10deg);
  transition: transform 0.4s ease;
}

.om-mockup-plinth:hover {
  transform: rotate(0deg) scale(1.05);
}

.om-plinth-level-txt {
  font-size: 1.4rem;
  font-weight: 800;
  color: #FFFFFF;
}

.om-plinth-wing-txt {
  font-size: 0.65rem;
  color: #FAF9F5;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.om-mockup-status-tag {
  position: absolute;
  bottom: 20px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  border-radius: var(--radius-full);
  background: rgba(0, 0, 0, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #FFFFFF;
  font-size: 0.72rem;
  font-weight: 600;
}

/* ==========================================================================
   CONCIERGE PANEL
   ========================================================================== */
.om-concierge-panel {
  background: rgba(250, 249, 245, 0.86);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.om-concierge-card-box {
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  display: grid;
  grid-template-columns: 1fr;
}

@media (min-width: 980px) {
  .om-concierge-card-box {
    grid-template-columns: 1.15fr 0.85fr;
  }
}

.om-concierge-details {
  padding: clamp(32px, 5vw, 60px);
  display: flex;
  flex-direction: column;
}

.om-concierge-grid-info {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
  margin-bottom: 36px;
}

@media (min-width: 600px) {
  .om-concierge-grid-info {
    grid-template-columns: repeat(2, 1fr);
  }
}

.om-concierge-point {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}

.om-point-icon {
  color: var(--accent-gold);
  margin-top: 2px;
  flex-shrink: 0;
}

.om-concierge-point strong {
  display: block;
  font-size: 0.95rem;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.om-concierge-point p {
  font-size: 0.82rem;
  color: var(--text-muted);
  line-height: 1.5;
  margin: 0;
}

.om-concierge-photo-col {
  position: relative;
  min-height: 380px;
  overflow: hidden;
}

.om-concierge-galleria-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.om-concierge-quote-tag {
  position: absolute;
  bottom: 24px;
  left: 24px;
  right: 24px;
  background: rgba(13, 22, 18, 0.88);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-md);
  padding: 20px;
  color: #FFFFFF;
}

.om-concierge-quote-tag p {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 1.05rem;
  line-height: 1.5;
  margin-bottom: 8px;
  color: #FAF9F5;
}

.om-concierge-quote-tag span {
  font-size: 0.72rem;
  color: var(--accent-gold);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-weight: 700;
}

